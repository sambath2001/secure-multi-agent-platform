# Copy to .env and fill in. .env is in .gitignore. Never commit real keys.

# Which provider to use: anthropic | openai | ollama
LLM_PROVIDER=anthropic
# Use the cheapest model your provider offers for development and evals.
LLM_MODEL=claude-haiku-5-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024

# Local spending guard (an estimate that stops a run early).
# The HARD cap is the monthly limit you set in your provider's billing dashboard. Set both.
MAX_TOTAL_TOKENS=1500000
# Optional: copy the per-million-token prices from your provider's pricing page to enable a USD cap and cost reporting.
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
MAX_USD=2.00
